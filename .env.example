# Copia este archivo a .env.local para desarrollo, o da de alta estas
# variables en el panel de tu hosting (Vercel: Project Settings → Environment
# Variables) para producción.

# API key de Resend (resend.com) — requerida para que el formulario de
# contacto envíe correo real. Sin esta variable, las solicitudes solo quedan
# en el log del servidor. Crear cuenta → API Keys → Create API Key.
RESEND_API_KEY=

# Remitente de los correos de notificación. Mientras no verifiques el dominio
# dasoksolutions.com dentro de Resend, deja este valor vacío (usa el remitente
# de pruebas onboarding@resend.dev). Una vez verificado el dominio en Resend
# (Domains → Add Domain → agregar los registros DNS que te indique),
# cámbialo a algo como: Dások All Solutions <formulario@dasoksolutions.com>
RESEND_FROM_EMAIL=
